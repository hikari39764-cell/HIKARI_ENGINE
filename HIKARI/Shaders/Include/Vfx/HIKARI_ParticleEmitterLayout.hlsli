// C++ と HLSL の粒子 emitter レイアウトを一元化する。
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_CURVE_KEYS, 8u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_COLOR_STOPS, 8u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FLOAT3_DISTRIBUTION_VALUES, 2u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FLOAT4_DISTRIBUTION_VALUES, 3u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_ANIMATED_FLOAT3_DISTRIBUTIONS, 6u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_ANIMATED_FLOAT3_CURVES, 3u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_CURVE_VALUES, 2u + HIKARI_PARTICLE_CURVE_KEYS)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_ANIMATED_FLOAT3_VALUES, HIKARI_PARTICLE_FLOAT3_DISTRIBUTION_VALUES * HIKARI_PARTICLE_ANIMATED_FLOAT3_DISTRIBUTIONS + HIKARI_PARTICLE_CURVE_VALUES * HIKARI_PARTICLE_ANIMATED_FLOAT3_CURVES)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_GRADIENT_VALUES, 1u + HIKARI_PARTICLE_COLOR_STOPS * 2u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_EMITTER_HEADER_COUNT, 19u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_POSITION_VALUES, HIKARI_PARTICLE_EMITTER_HEADER_COUNT)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_ROTATION_VALUES, HIKARI_PARTICLE_POSITION_VALUES + HIKARI_PARTICLE_ANIMATED_FLOAT3_VALUES)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_SCALE_VALUES, HIKARI_PARTICLE_ROTATION_VALUES + HIKARI_PARTICLE_ANIMATED_FLOAT3_VALUES)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_COLOR_DISTRIBUTIONS, HIKARI_PARTICLE_SCALE_VALUES + HIKARI_PARTICLE_ANIMATED_FLOAT3_VALUES)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_COLOR_CURVES, HIKARI_PARTICLE_COLOR_DISTRIBUTIONS + HIKARI_PARTICLE_FLOAT4_DISTRIBUTION_VALUES * 4u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_COLOR_GRADIENT, HIKARI_PARTICLE_COLOR_CURVES + HIKARI_PARTICLE_CURVE_VALUES * 4u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_EMITTER_VALUE_COUNT, HIKARI_PARTICLE_COLOR_GRADIENT + HIKARI_PARTICLE_GRADIENT_VALUES)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FIELD_CENTER, 15u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FIELD_AXIS, 16u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FIELD_FLOW, 17u)
HIKARI_PARTICLE_LAYOUT(HIKARI_PARTICLE_FIELD_TIME, 18u)
