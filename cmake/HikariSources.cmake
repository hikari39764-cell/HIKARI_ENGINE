# Public GameProject SDK exports have one compile/link owner. Keeping these
# translation units in a dedicated archive lets each Host retain the complete
# SDK surface without whole-archiving the broader runtime composition module.
set(HIKARI_GAME_PROJECT_SDK_EXPORT_SOURCES ${HIKARI_RUNTIME_SOURCES})
# Runtime Bridge translation units own the public SDK entry points. Classify
# by that responsibility instead of maintaining another list of individual APIs.
set(HIKARI_GAME_PROJECT_SDK_EXPORT_PATTERN
    "(HIKARI_RuntimeFeatureCatalog|HIKARI_GameProject[^/]*Bridge|HIKARI_GameProjectRegistration)\\.cpp$")
list(
    FILTER
    HIKARI_GAME_PROJECT_SDK_EXPORT_SOURCES
    INCLUDE
    REGEX "${HIKARI_GAME_PROJECT_SDK_EXPORT_PATTERN}")
if(NOT HIKARI_GAME_PROJECT_SDK_EXPORT_SOURCES)
    message(FATAL_ERROR "The GameProject SDK export owner has no sources.")
endif()

