{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "hikari-vs2022-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "HIKARI Debug Editor",
      "inherits": "hikari-vs2022-base",
      "binaryDir": "${sourceDir}/out/build/debug",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/debug",
        "HIKARI_PRODUCT": "Debug"
      }
    },
    {
      "name": "editor-release",
      "displayName": "HIKARI Editor Release",
      "inherits": "hikari-vs2022-base",
      "binaryDir": "${sourceDir}/out/build/editor-release",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "EditorRelease",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/editor-release",
        "HIKARI_PRODUCT": "EditorRelease"
      }
    },
    {
      "name": "game-shipping",
      "displayName": "HIKARI Game Shipping",
      "inherits": "hikari-vs2022-base",
      "binaryDir": "${sourceDir}/out/build/game-shipping",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Shipping",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/game-shipping",
        "HIKARI_GAME_HOST_OUTPUT_NAME": "HIKARI_Game",
        "HIKARI_PRODUCT": "Shipping"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "targets": [
        "HIKARI_ProjectLauncher"
      ]
    },
    {
      "name": "editor-release",
      "configurePreset": "editor-release",
      "configuration": "EditorRelease",
      "targets": [
        "HIKARI_ProjectLauncher"
      ]
    },
    {
      "name": "game-shipping",
      "configurePreset": "game-shipping",
      "configuration": "Shipping",
      "targets": [
        "HIKARI_GameHost"
      ]
    }
  ]
}
